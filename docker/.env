# DreamZero + Isaac Sim Docker Configuration
# Copy this file to .env and adjust paths for your environment.

# ============================================================
# Host paths  (the only section that changes between machines)
# ============================================================
# Absolute path to the repo root on the host
REPO_DIR=/home/ubuntu/dreamzero
# Directory where model checkpoints are stored (can be on a fast/ephemeral disk)
CHECKPOINTS_DIR=/home/ubuntu/dreamzero/checkpoints

# ============================================================
# GPU
# ============================================================
NVIDIA_VISIBLE_DEVICES=all

# ============================================================
# DreamZero Inference  (container-internal paths)
# ============================================================
DREAMZERO_PORT=8000
NUM_INFERENCE_GPUS=1
MODEL_PATH=/checkpoints/franka_orca_lora
WAN_CKPT_DIR=/checkpoints/Wan2.1-I2V-14B-480P
TOKENIZER_DIR=/checkpoints/umt5-xxl
TEXT_ENCODER_PRETRAINED_PATH=/checkpoints/Wan2.1-I2V-14B-480P/models_t5_umt5-xxl-enc-bf16.pth
IMAGE_ENCODER_PRETRAINED_PATH=/checkpoints/Wan2.1-I2V-14B-480P/models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth
VAE_PRETRAINED_PATH=/checkpoints/Wan2.1-I2V-14B-480P/Wan2.1_VAE.pth
ATTENTION_BACKEND=TE
ENABLE_DIT_CACHE=true

# ============================================================
# Isaac Sim
# ============================================================
LIVESTREAM_PORT=8211
LIVESTREAM_DATA_PORT=49100

# ============================================================
# Training
# ============================================================
TRAINING_BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3
HF_TOKEN=
WANDB_API_KEY=
NUM_GPUS=

# ============================================================
# Eval
# ============================================================
EVAL_INSTRUCTION="pick up the object"
EVAL_EPISODES=10
EVAL_OPEN_LOOP_HORIZON=24
